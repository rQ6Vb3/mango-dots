// mangobar config (JSONC).
{
    "layer": "top",
    "height": 20,
    "buffer-scale": 1,
    // "scroll-interval": 100,
    // "smooth-scrolling-threshold": 5.0,

    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],

    "modules-center": [],

    "modules-right": [
        "tray",
	"custom/weather",
        "hideclients",
        "pulseaudio",
        "network",
        "battery",
	"clock"
    ],

    "workspaces": {
        "hide-empty": true,
        // "pinned": [1, 2],
        // "tag-names": ["1", "2", "3", "编", "网"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle",
	"on-scroll-up": "mmsg dispatch viewtoleft,0",
	"on-scroll-down": "mmsg dispatch viewtoright,0"
    },

    "layout": {
        "format": "[{}]",
	"on-click": "mmsg dispatch switch_layout"
    },

    "window": {
        "format": "{}",
        "max-length": 400,
        "on-click": "mmsg dispatch toggleoverview,1",
        "on-click-right": "mmsg dispatch toggleoverview",
	"on-click-middle": "mmsg dispatch killclient",
	"on-scroll-up": "mmsg dispatch focusstack,next",
	"on-scroll-down": "mmsg dispatch focusstack,prev"
    },

    "network": {
        "format": "  {}",
	"on-click": "status.sh wifi_info"
    },

    "hideclients": {
        "format": "  {}"
    },

    "cpu": {
        "format": " {load}%"
    },

    "memory": {
        "format": " {}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume} {bt}",
        "format-muted": "󰝟 {volume} {bt}",
        "icons": ["󰕿", "󰖀", "󰕾"],
        "icon-bluetooth": "",
        "on-click-right": "status.sh bluetooth_info",
        "on-click": "volume mute",
        "on-scroll-up": "volume up",
        "on-scroll-down": "volume down"
    },

    "battery": {
        "format": "{icon}  {percent}",
        "icons": ["", "", "", "", ""],
        "icon-charging": "󱐋",
        "icon-full": "",
        "icon-ac": "",
	"on-click": "status.sh battery_info"
        // "hide-on-ac": true
    },

    "clock": {
        "format": "  {:L%a %b %d, %I:%M %p}",
	"on-click": "status.sh datetime_info",
	"on-click-right": "gsimplecal"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }

}
